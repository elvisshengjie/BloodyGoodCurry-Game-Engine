{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "conf-common",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}"
    },
    {
      "name": "conf-windows-common",
      "hidden": true,
      "inherits": "conf-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "conf-unixlike-common",
      "hidden": true,
      "inherits": "conf-common",
      "generator": "Ninja",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "conf-web-common",
      "hidden": true,
      "inherits": "conf-common",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_C_COMPILER": "$env{EMSDK}/upstream/emscripten/emcc.bat",
        "CMAKE_CXX_COMPILER": "$env{EMSDK}/upstream/emscripten/em++.bat",
        "SOFASPUDS_ENABLE_EDITOR": "OFF",
        "SOFASPUDS_DISABLE_AUDIO": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (Editor ON)",
      "inherits": "conf-windows-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOFASPUDS_ENABLE_EDITOR": "ON",
        "SOFASPUDS_DISABLE_AUDIO": "OFF"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (Editor OFF)",
      "inherits": "conf-windows-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SOFASPUDS_ENABLE_EDITOR": "OFF",
        "SOFASPUDS_DISABLE_AUDIO": "OFF"
      }
    },
    {
      "name": "web-debug",
      "displayName": "Web Debug (Editor OFF)",
      "inherits": "conf-web-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOFASPUDS_WEB_SINGLE_FILE": "OFF"
      }
    },
    {
      "name": "web-release-split",
      "displayName": "Web Release Split (Editor OFF)",
      "inherits": "conf-web-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SOFASPUDS_WEB_SINGLE_FILE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug",
      "configuration": "Debug"
    },
    {
      "name": "web-release-split",
      "configurePreset": "web-release-split",
      "configuration": "Release"
    }
  ]
}
